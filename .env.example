# Database (PostgreSQL via Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=komnottra
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@db:5432/komnottra?schema=public"

# Application Web Configuration
PORT=3000
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"
JWT_SECRET="your-jwt-secret-here"

# Google OAuth Credentials (optional, for Google Sign-In)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Gemini Vision API (Recommended)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# OmniRoute AI Gateway Service (Docker service: omniroute)
AI_BASE_URL="http://omniroute:20128/v1"
AI_API_KEY=""
CHAT_MODEL="serka-space"
REASONING_EFFORT="none"
OMNIROUTE_PORT=20128
OMNIROUTE_REQUIRE_API_KEY="false"

# Cloudflare Tunnel Configuration
CLOUDFLARE_TUNNEL_TOKEN=""
